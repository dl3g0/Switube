<brls:AppletFrame
    iconInterpolation="linear"
    headerHidden="true"
    footerHidden="false">

    <GradientBox
        axis="column"
        width="100%"
        height="100%">

        <brls:TabFrame
            id="tabFrame"
            title="Switube"
            icon="@res/icon/icon.jpg"
            grow="1.0">

            <brls:Tab label="Home">
                <HomeTab />
            </brls:Tab>

            <brls:Tab label="Search">
                <SearchTab />
            </brls:Tab>

            <brls:Tab label="Library">
                <LibraryTab />
            </brls:Tab>

            <brls:Tab label="Downloads">
                <DownloadsTab />
            </brls:Tab>

            <brls:Tab label="Now Playing">
                <NowPlayingTab />
            </brls:Tab>

            <brls:Tab label="Settings">
                <SettingsTab />
            </brls:Tab>

        </brls:TabFrame>

        <MiniPlayer />

    </GradientBox>

</brls:AppletFrame>
